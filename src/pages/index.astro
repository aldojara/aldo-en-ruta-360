---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/patterns/PageHero.astro';
---

<BaseLayout title="Aldo en Ruta | Viajes por carretera, mapas y relatos 360°">
  <PageHero
    eyebrow="Colección Piloto: Perú en Ruta 360°"
    title="Explora el Perú por Carretera"
    description="Viaja a través de relatos interactivos, mapas cartográficos precisos, perfiles de elevación y escenas inmersivas en 360 grados. Siente la distancia, la altura y el relieve de las rutas más desafiantes."
    primaryAction={{ href: '/rutas', label: 'Ver las Rutas' }}
    secondaryAction={{ href: '/explorar', label: 'Explorar el Mapa' }}
    variant="large"
  />
</BaseLayout>
