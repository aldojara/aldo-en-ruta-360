---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RoutesHero from '../../components/routes/RoutesHero.astro';
import RoutesSummary from '../../components/routes/RoutesSummary.astro';
import RoutesToolbar from '../../components/routes/RoutesToolbar.astro';
import RoutesCatalog from '../../components/routes/RoutesCatalog.astro';
import RouteContentsSection from '../../components/routes/RouteContentsSection.astro';
import RoutesClosingCallout from '../../components/routes/RoutesClosingCallout.astro';
import { getFeaturedRoute } from '../../lib/content/get-featured-route';
import { siteConfig } from '../../data/site';

const featuredRoute = await getFeaturedRoute({
  includeDrafts: siteConfig.content.showPrototypeDraftRoute,
});

if (!featuredRoute) {
  throw new Error("No se encontró la ruta piloto destacada en las Content Collections.");
}
---

<BaseLayout
  title="Rutas por carretera | Aldo en Ruta"
  description="Consulta los recorridos documentados por carretera de Aldo en Ruta, con información geográfica, audiovisual y narrativa de cada trayecto."
  overlayHeader={true}
>
  <RoutesHero />
  <RoutesSummary />
  <RoutesToolbar />
  <RoutesCatalog featuredRoute={featuredRoute} />
  <RouteContentsSection />
  <RoutesClosingCallout />
</BaseLayout>
