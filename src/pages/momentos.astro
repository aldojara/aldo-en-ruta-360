---
import ListingLayout from '../layouts/ListingLayout.astro';
import PageHero from '../components/patterns/PageHero.astro';
---

<ListingLayout title="Aldo en Ruta | Momentos en Carretera">
  <PageHero
    eyebrow="Galería Visual"
    title="Momentos"
    description="Una colección visual de instantes en carretera. Instantáneas, clips cortos y miradas inmersivas que detienen el viaje en el tiempo."
  />
  <div class="container moments-placeholder animate-fade-in">
    <div class="placeholder-box">
      <p>Galería de Momentos - Las colecciones dinámicas de imágenes, vídeos e hitos se integrarán en la siguiente fase.</p>
    </div>
  </div>
</ListingLayout>

<style>
  .moments-placeholder {
    padding: 60px 20px;
  }
  .placeholder-box {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 40px;
    background-color: var(--color-bg-secondary);
    text-align: center;
    color: var(--color-text-secondary);
  }
</style>
