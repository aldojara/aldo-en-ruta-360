---
import BaseLayout from '../layouts/BaseLayout.astro';
import MomentsHero from '../components/moments/MomentsHero.astro';
import MomentsMediaSummary from '../components/moments/MomentsMediaSummary.astro';
import MomentsFilters from '../components/moments/MomentsFilters.astro';
import MomentsGallery from '../components/moments/MomentsGallery.astro';
import PilotMomentsTimeline from '../components/moments/PilotMomentsTimeline.astro';
import MomentsQuoteSection from '../components/moments/MomentsQuoteSection.astro';
import MomentsClosingCallout from '../components/moments/MomentsClosingCallout.astro';

import { getRelatedMoments } from '../lib/content/get-related-moments';
import { siteConfig } from '../data/site';

// Consultar los momentos del tramo piloto de forma dinámica de la Content Collection
const showDrafts = siteConfig.content.showPrototypeDraftRoute;
const moments = await getRelatedMoments('ruta-piloto', {
  includeDrafts: showDrafts
});

// Metadatos SEO centralizados
const seoTitle = "Momentos de carretera | Aldo en Ruta";
const seoDescription = "Descubre fotografías, escenas y momentos vinculados a los recorridos de Aldo en Ruta por las carreteras del Perú.";
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  overlayHeader={true}
>
  <MomentsHero />
  <MomentsMediaSummary />
  <MomentsFilters />
  <MomentsGallery moments={moments} />
  <PilotMomentsTimeline moments={moments} />
  <MomentsQuoteSection />
  <MomentsClosingCallout />
</BaseLayout>
