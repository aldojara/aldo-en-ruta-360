---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutStats from '../components/about/AboutStats.astro';
import AboutStory from '../components/about/AboutStory.astro';
import AboutValues from '../components/about/AboutValues.astro';
import AboutPlaces from '../components/about/AboutPlaces.astro';
import AboutClosingCallout from '../components/about/AboutClosingCallout.astro';
import { aboutPageData } from '../data/about';
---

<BaseLayout
  title={aboutPageData.seo.title}
  description={aboutPageData.seo.description}
  canonicalURL={aboutPageData.seo.canonical}
  noindex={aboutPageData.seo.noindex}
  ogImage={aboutPageData.seo.ogImage}
  overlayHeader={true}
>
  <!-- 1. Hero Cinematográfico y Retrato -->
  <AboutHero hero={aboutPageData.hero} />

  <!-- 2. Franja de Indicadores con Estados de Validación -->
  <AboutStats metrics={aboutPageData.metrics} />

  <!-- 3. Historia: De la tecnología a la exploración -->
  <AboutStory story={aboutPageData.story} />

  <!-- 4. Sección de Valores Editorial -->
  <AboutValues values={aboutPageData.values} />

  <!-- 5. Galería Horizontal de Lugares que Inspiran -->
  <AboutPlaces places={aboutPageData.places} />

  <!-- 6. CTA Final: Invitación a Explorar Rutas -->
  <AboutClosingCallout closing={aboutPageData.closing} />
</BaseLayout>
