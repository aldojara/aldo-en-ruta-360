---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutStats from '../components/about/AboutStats.astro';
import AboutStory from '../components/about/AboutStory.astro';
import AboutValues from '../components/about/AboutValues.astro';
import AboutPlaces from '../components/about/AboutPlaces.astro';
import AboutClosingCallout from '../components/about/AboutClosingCallout.astro';
import { aboutPageData } from '../data/about';

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": "https://aldoalvolante.com/sobre-aldo/#profilepage",
      "url": "https://aldoalvolante.com/sobre-aldo/",
      "name": "Aldo Jara Pisconti | Creador de Aldo al Volante",
      "inLanguage": "es",
      "mainEntity": {
        "@id": "https://aldojarapisconti.com/#person"
      },
      "isPartOf": {
        "@id": "https://aldoalvolante.com/#website"
      }
    },
    {
      "@type": "Person",
      "@id": "https://aldojarapisconti.com/#person",
      "name": "Aldo Jara Pisconti",
      "url": "https://aldojarapisconti.com/",
      "description": "Creador y autor de Aldo al Volante, un proyecto de viajes por carretera, rutas, paisajes y experiencias inmersivas por el Perú.",
      "sameAs": [
        "https://www.linkedin.com/in/aldojarapisconti/",
        "https://www.youtube.com/@aldopisconti",
        "https://bigtalentanalytica.com/sobre-mi",
        "https://aprendefrancesviajando.com/sobre-nosotros/aldo-jara-pisconti/",
        "https://aldoalvolante.com/sobre-aldo/"
      ],
      "knowsAbout": [
        "viajes por carretera",
        "rutas por el Perú",
        "experiencias inmersivas",
        "fotografía de viajes",
        "cartografía de recorridos"
      ]
    }
  ]
};
---

<BaseLayout
  title={aboutPageData.seo.title}
  description={aboutPageData.seo.description}
  canonicalURL={aboutPageData.seo.canonical}
  noindex={aboutPageData.seo.noindex}
  ogImage={aboutPageData.seo.ogImage}
  ogImageAlt="Aldo Jara Pisconti conduciendo durante un recorrido por carretera"
  ogImageWidth={3105}
  ogImageHeight={2687}
  ogType="profile"
  structuredData={aboutSchema}
  overlayHeader={true}
>
  <!-- 1. Hero Cinematográfico y Retrato -->
  <AboutHero hero={aboutPageData.hero} />

  <!-- 2. Franja de Indicadores con Estados de Validación -->
  <AboutStats metrics={aboutPageData.metrics} />

  <!-- 3. Historia: De la tecnología a la exploración -->
  <AboutStory story={aboutPageData.story} />

  <!-- 4. Sección de Valores Editorial -->
  <AboutValues values={aboutPageData.values} />

  <!-- 5. Galería Horizontal de Lugares que Inspiran -->
  <AboutPlaces places={aboutPageData.places} />

  <!-- 6. CTA Final: Invitación a Explorar Rutas -->
  <AboutClosingCallout closing={aboutPageData.closing} />
</BaseLayout>
