---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoriesHero from '../components/stories/StoriesHero.astro';
import FeaturedStoriesGrid from '../components/stories/FeaturedStoriesGrid.astro';
import StoryFilterBar from '../components/stories/StoryFilterBar.astro';
import StoryList from '../components/stories/StoryList.astro';
import PilotStoryTimeline from '../components/stories/PilotStoryTimeline.astro';
import StoriesQuoteBlock from '../components/stories/StoriesQuoteBlock.astro';
import StoriesClosingCallout from '../components/stories/StoriesClosingCallout.astro';

import { getRelatedStories } from '../lib/content/get-related-stories';
import { siteConfig } from '../data/site';

// Consultar historias dinámicamente de la colección
const showDrafts = siteConfig.content.showPrototypeDraftRoute;
const allStories = await getRelatedStories({
  includeDrafts: showDrafts
});

const featuredStories = allStories.filter(story => story.data.featured);
const secondaryStories = allStories.filter(story => !story.data.featured);

// Metadatos SEO centralizados
const seoTitle = "Historias de carretera | Aldo al Volante";
const seoDescription = "Crónicas, aprendizajes y relatos vinculados con las rutas por carretera de Aldo al Volante, desde la preparación del viaje hasta las experiencias que deja cada recorrido.";
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  overlayHeader={true}
>
  <StoriesHero />
  <FeaturedStoriesGrid stories={featuredStories} />
  <StoryFilterBar />
  <StoryList stories={secondaryStories} />
  <PilotStoryTimeline />
  <StoriesQuoteBlock />
  <StoriesClosingCallout />
</BaseLayout>
