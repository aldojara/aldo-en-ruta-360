---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreHero from '../components/explore/ExploreHero.astro';
import ExploreMapSection from '../components/explore/ExploreMapSection.astro';
import TerritoryGrid from '../components/explore/TerritoryGrid.astro';
import ExperienceCategoryGrid from '../components/explore/ExperienceCategoryGrid.astro';
import FeaturedRoutesSection from '../components/explore/FeaturedRoutesSection.astro';
import { getFeaturedRoute } from '../lib/content/get-featured-route';
import { siteConfig } from '../data/site';

const featuredRoute = await getFeaturedRoute({
  includeDrafts: siteConfig.content.showPrototypeDraftRoute,
});

if (!featuredRoute) {
  throw new Error("No se encontró la ruta piloto destacada en las Content Collections.");
}
---

<BaseLayout
  title="Explorar | Aldo al Volante"
  description="Descubre el territorio peruano a través de rutas, paisajes y experiencias de conducción."
  overlayHeader={true}
>
  <ExploreHero />
  <ExploreMapSection featuredRoute={featuredRoute} />
  <TerritoryGrid />
  <ExperienceCategoryGrid />
  <FeaturedRoutesSection featuredRoute={featuredRoute} />
</BaseLayout>
