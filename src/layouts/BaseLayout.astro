---
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import '../styles/global.css';
import { publicUrl } from '../lib/urls/public-url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
  overlayHeader?: boolean;
}

const {
  title = "Aldo al Volante | Viajes por carretera, mapas y relatos 360°",
  description = "Explora el Perú por carretera de forma interactiva. Rutas con mapas dinámicos, perfiles de altitud, sincronización de vídeo y escenas inmersivas en 360°.",
  ogImage = "/assets/og-image-default.jpg",
  canonicalURL,
  noindex = false,
  overlayHeader = false
} = Astro.props;

// Resolución del Canonical URL estable sin parámetros ni fragmentos
const canonical = canonicalURL
  ? new URL(canonicalURL, Astro.site ?? Astro.url.origin)
  : new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

canonical.search = '';
canonical.hash = '';
const canonicalString = canonical.href;

// Resolución de favicons y OG image con base path
const resolvedFaviconSvg = publicUrl('/favicon.svg');
const resolvedFaviconIco = publicUrl('/favicon.ico');
const resolvedOgImagePath = publicUrl(ogImage);
const resolvedOgImageURL = new URL(resolvedOgImagePath, Astro.site ?? Astro.url.origin).href;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="icon" type="image/svg+xml" href={resolvedFaviconSvg} />
    <link rel="icon" href={resolvedFaviconIco} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalString} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalString} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalString} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style>
      :root {
        --font-interface: 'Outfit', system-ui, sans-serif;
      }
    </style>
  </head>
  <body>
    <SiteHeader />

    <main id="main-content" class={`main-content ${overlayHeader ? 'main-content--overlay-header' : ''}`}>
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1 0 auto;
    padding-top: calc(var(--header-height) + 40px);
    display: flex;
    flex-direction: column;
  }

  .main-content.main-content--overlay-header {
    padding-top: 0;
  }
</style>
