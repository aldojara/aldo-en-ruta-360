---
import { publicUrl } from '../../lib/urls/public-url';

interface Props {
  title: string;
  description: string;
  /**
   * Imagen de fondo decorativa.
   * Toda la información esencial se transmite mediante título y descripción,
   * por lo que esta imagen de fondo no requiere texto alternativo directo (alt).
   */
  backgroundImage?: string;
  action?: {
    href: string;
    label: string;
  };
}

const {
  title,
  description,
  backgroundImage,
  action
} = Astro.props;

const hasBg = !!backgroundImage;
const resolvedBgUrl = hasBg ? publicUrl(backgroundImage) : undefined;
---

<section class={`closing-callout glass-panel ${hasBg ? 'has-bg' : ''}`} style={resolvedBgUrl ? `background-image: url('${resolvedBgUrl}')` : undefined}>
  {hasBg && <div class="callout-overlay" aria-hidden="true" />}
  
  <div class="callout-container container animate-fade-in">
    <h2 class="callout-title">{title}</h2>
    <p class="callout-desc">{description}</p>
    
    {action && (
      <a href={action.href} class="btn btn-callout">
        {action.label}
      </a>
    )}
  </div>
</section>

<style>
  .closing-callout {
    position: relative;
    padding: 60px 40px;
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: 48px 0;
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .closing-callout.has-bg {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .callout-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to right, rgba(8, 20, 28, 0.95), rgba(5, 12, 18, 0.8));
    z-index: 1;
  }

  .callout-container {
    position: relative;
    z-index: 2;
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .callout-title {
    font-size: 2rem;
    color: var(--color-text-primary);
  }

  .callout-desc {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .btn-callout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    background-color: var(--color-accent);
    color: var(--color-bg-primary);
    border: 1px solid var(--color-accent);
    font-family: var(--font-interface);
    font-weight: 600;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    margin-top: 12px;
    transition: var(--transition-smooth);
  }

  .btn-callout:hover {
    background-color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(216, 154, 43, 0.25);
  }
</style>
