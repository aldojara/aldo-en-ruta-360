---
import { routesPageFilters } from '../../data/routes-page';
---

<div class="routes-toolbar container animate-fade-in" aria-label="Controles del catálogo">
  <div class="toolbar-wrapper">
    <!-- Grupo de Filtros de Estado -->
    <div class="toolbar-group" role="group" aria-label="Filtros de estado de ruta">
      <span class="group-title">Filtrar por estado:</span>
      <div class="filter-buttons">
        {routesPageFilters.map(filter => (
          <button
            type="button"
            class={`toolbar-btn filter-btn ${filter.id === 'all' ? 'active' : ''}`}
            disabled={filter.id !== 'all'}
            aria-disabled={filter.id !== 'all' ? 'true' : 'false'}
            aria-pressed={filter.id === 'all' ? 'true' : 'false'}
          >
            {filter.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Grupo de Ordenación -->
    <div class="toolbar-group" role="group" aria-label="Ordenación de rutas">
      <span class="group-title">Ordenar por:</span>
      <div class="sort-selector-wrapper">
        <button
          type="button"
          class="toolbar-btn sort-btn"
          disabled
          aria-disabled="true"
          aria-haspopup="listbox"
        >
          <span>Destacadas</span>
          <svg class="dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="toolbar-help">
    <span class="help-text">Filtros y ordenación disponibles en una siguiente fase.</span>
  </div>
</div>

<style>
  .routes-toolbar {
    margin-bottom: 2.5rem;
  }

  .toolbar-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem;
    background-color: rgba(16, 27, 36, 0.4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    flex-wrap: wrap;
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .group-title {
    font-family: var(--font-interface);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* Botones Generales de la Barra */
  .toolbar-btn {
    padding: 0.5rem 1rem;
    font-family: var(--font-interface);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 50px;
    cursor: pointer;
    transition: var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toolbar-btn:hover:not(:disabled) {
    border-color: var(--color-border-hover);
    color: var(--color-text-primary);
  }

  .toolbar-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Activo */
  .toolbar-btn.active {
    background-color: var(--color-accent-dim);
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
    font-weight: 600;
  }

  /* Deshabilitado */
  .toolbar-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    background-color: rgba(16, 27, 36, 0.2);
    border-color: rgba(184, 190, 196, 0.06);
    color: var(--color-text-muted);
  }

  /* Sort dropdown button specific styling */
  .sort-btn {
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    padding: 0.5rem 1.25rem;
    min-width: 140px;
    justify-content: space-between;
  }

  .dropdown-icon {
    width: 14px;
    height: 14px;
    color: var(--color-text-muted);
  }

  /* Ayuda */
  .toolbar-help {
    margin-top: 0.5rem;
    padding-left: 0.5rem;
  }

  .help-text {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Adaptabilidad */
  @media (max-width: 768px) {
    .toolbar-wrapper {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 1.25rem 1rem;
    }

    .toolbar-group {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .filter-buttons {
      width: 100%;
    }

    .filter-btn {
      flex: 1;
      min-width: 110px;
      justify-content: center;
    }

    .sort-btn {
      width: 100%;
    }
  }
</style>
