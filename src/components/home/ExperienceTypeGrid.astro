---
import ExperienceTypeCard from './ExperienceTypeCard.astro';

interface Props {
  title?: string;
}

const { title = "Elige tu tipo de experiencia" } = Astro.props;
---

<section class="experience-section container" aria-labelledby="exp-title">
  <h2 id="exp-title" class="section-title">{title}</h2>

  <div class="experience-grid">

    <!-- Tarjeta 1: Desierto -->
    <ExperienceTypeCard
      title="Desierto"
      description="Rutas secas y paisajes infinitos."
      image="/images/temp/home/experience-desert.webp"
      exploreHref="/explorar/"
    >
      <!-- Icono de Cactus -->
      <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v20"></path>
        <path d="M17 8a4 4 0 0 1-4 4"></path>
        <path d="M7 16a4 4 0 0 0 4-4"></path>
        <path d="M17 8V6"></path>
        <path d="M7 16v2"></path>
      </svg>
    </ExperienceTypeCard>

    <!-- Tarjeta 2: Andes -->
    <ExperienceTypeCard
      title="Andes"
      description="Montañas, altura y curvas inolvidables."
      image="/images/temp/home/experience-andes.webp"
      exploreHref="/explorar/"
    >
      <!-- Icono de Nevados/Montañas -->
      <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
      </svg>
    </ExperienceTypeCard>

    <!-- Tarjeta 3: Selva -->
    <ExperienceTypeCard
      title="Selva"
      description="Vegetación densa y caminos vivos."
      image="/images/temp/home/experience-jungle.webp"
      exploreHref="/explorar/"
    >
      <!-- Icono de Árbol/Bosque -->
      <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5"></path>
        <path d="M12 5a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z"></path>
        <path d="M12 10a5 5 0 0 0-5 5h10a5 5 0 0 0-5-5Z"></path>
        <path d="M9 19h6"></path>
      </svg>
    </ExperienceTypeCard>

    <!-- Tarjeta 4: Costa -->
    <ExperienceTypeCard
      title="Costa"
      description="Carreteras junto al mar y acantilados."
      image="/images/temp/home/experience-coast.webp"
      exploreHref="/explorar/"
    >
      <!-- Icono de Olas del Mar -->
      <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.6 2 5.1 2 2.5 0 2.5-2 5.1-2 1.3 0 2 .5 2.5 1"></path>
        <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5.1-2 2.5 0 2.5 2 5.1 2 2.5 0 2.5-2 5.1-2 1.3 0 2 .5 2.5 1"></path>
        <path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5.1-2 2.5 0 2.5 2 5.1 2 2.5 0 2.5-2 5.1-2 1.3 0 2 .5 2.5 1"></path>
      </svg>
    </ExperienceTypeCard>

    <!-- Tarjeta 5: Rutas Sinuosas -->
    <ExperienceTypeCard
      title="Rutas sinuosas"
      description="Curvas, pendientes y adrenalina."
      image="/images/temp/home/experience-winding-road.webp"
      exploreHref="/explorar/"
    >
      <!-- Icono de Carretera con Curvas Sinuosas -->
      <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v4"></path>
        <path d="M12 18v4"></path>
        <path d="M12 6c-3 0-5 2-5 5s2 5 5 5 5 2 5 5-2 5-5 5"></path>
      </svg>
    </ExperienceTypeCard>

  </div>
</section>

<style>
  .experience-section {
    padding-top: 80px;
    padding-bottom: 80px;
    width: 100%;
  }

  .section-title {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 48px;
    text-align: left;
    letter-spacing: -0.01em;
  }

  /* Grid en 5 columnas para escritorio, reajustable en responsive */
  .experience-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    width: 100%;
  }

  @media (max-width: 1200px) {
    .experience-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .experience-section {
      padding-top: 60px;
      padding-bottom: 60px;
    }

    .section-title {
      margin-bottom: 32px;
    }

    .experience-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .experience-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
