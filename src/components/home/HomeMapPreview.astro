---
/**
 * NOTA TÉCNICA:
 * Este componente es una representación visual estática y provisional del mapa
 * territorial del Perú. Utiliza gráficos vectoriales (SVG) responsivos para emular
 * la maqueta del producto, mostrando el tramo piloto y las rutas futuras de forma accesible.
 *
 * Se sustituirá por un mapa dinámico e interactivo (MapLibre GL JS) en fases futuras
 * cuando se integre el motor cartográfico definitivo y las coordenadas GPX oficiales.
 */
---

<div class="map-preview-container" role="img" aria-label="Mapa territorial de Perú mostrando el contorno del país en tonos oscuros. Destaca en dorado el trazado de la Ruta Andina - Tramo Piloto en la zona central y muestra trazos punteados en color verde azulado y gris para rutas futuras en el norte, selva y sur.">
  <div class="map-aspect-ratio">

    <!-- SVG del Mapa Territorial -->
    <svg viewBox="0 0 500 620" class="map-svg" xmlns="http://www.w3.org/2000/svg">
      <!-- Filtros de Sombra y Brillo para Estética Premium -->
      <defs>
        <filter id="glow-gold" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="6" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
        <filter id="shadow-dark" x="-10%" y="-10%" width="120%" height="120%">
          <feDropShadow dx="2" dy="8" stdDeviation="10" flood-color="#000000" flood-opacity="0.6" />
        </filter>
      </defs>

      <!-- Retícula de Coordenadas Cartográficas (Estética de Aventura) -->
      <g class="map-grid" stroke="rgba(245, 245, 240, 0.04)" stroke-width="0.5">
        <line x1="50" y1="0" x2="50" y2="620" />
        <line x1="150" y1="0" x2="150" y2="620" />
        <line x1="250" y1="0" x2="250" y2="620" />
        <line x1="350" y1="0" x2="350" y2="620" />
        <line x1="450" y1="0" x2="450" y2="620" />
        <line x1="0" y1="100" x2="500" y2="100" />
        <line x1="0" y1="200" x2="500" y2="200" />
        <line x1="0" y1="300" x2="500" y2="300" />
        <line x1="0" y1="400" x2="500" y2="400" />
        <line x1="0" y1="500" x2="500" y2="500" />
      </g>

      <!-- Contorno de Perú (Styling Oscuro y Detallado) -->
      <path
        class="peru-contour"
        d="M 120 40
           C 160 50, 190 45, 220 70
           C 240 85, 260 110, 280 115
           C 300 120, 310 135, 335 155
           C 355 170, 370 190, 380 210
           C 400 240, 420 260, 425 285
           C 430 310, 410 330, 400 350
           C 390 370, 395 390, 385 410
           C 375 430, 395 450, 390 475
           C 385 500, 370 515, 360 530
           C 350 545, 325 565, 310 575
           C 300 580, 290 575, 280 560
           C 270 545, 255 520, 245 505
           C 235 490, 215 470, 205 460
           C 185 440, 170 420, 155 385
           C 140 350, 125 320, 110 290
           C 95 260, 75 235, 65 210
           C 55 185, 75 160, 85 140
           C 95 120, 110 100, 115 80
           Z"
        fill="#0b1122"
        stroke="rgba(245, 245, 240, 0.15)"
        stroke-width="1.5"
        filter="url(#shadow-dark)"
      />

      <!-- Capas de Océano y Tierra Extra para Contraste -->
      <path
        class="peru-contour-inner"
        d="M 120 40
           C 160 50, 190 45, 220 70
           C 240 85, 260 110, 280 115
           C 300 120, 310 135, 335 155
           C 355 170, 370 190, 380 210
           C 400 240, 420 260, 425 285
           C 430 310, 410 330, 400 350
           C 390 370, 395 390, 385 410
           C 375 430, 395 450, 390 475
           C 385 500, 370 515, 360 530
           C 350 545, 325 565, 310 575
           C 300 580, 290 575, 280 560
           C 270 545, 255 520, 245 505
           C 235 490, 215 470, 205 460
           C 185 440, 170 420, 155 385
           C 140 350, 125 320, 110 290
           C 95 260, 75 235, 65 210
           C 55 185, 75 160, 85 140
           C 95 120, 110 100, 115 80
           Z"
        fill="rgba(19, 29, 56, 0.3)"
        pointer-events="none"
      />

      <!-- Etiquetas Geográficas de Regiones Conceptuales (Deshabilitadas en Lectura Accesible) -->
      <g class="map-labels" fill="rgba(245, 245, 240, 0.4)" font-family="var(--font-interface)" font-size="10.5" letter-spacing="0.08em" aria-hidden="true">
        <text x="135" y="170" text-anchor="middle">Costa Norte</text>
        <text x="210" y="270" text-anchor="middle">Sierra Central</text>
        <text x="330" y="295" text-anchor="middle">Selva Central</text>
        <text x="175" y="485" text-anchor="middle">Costa Sur</text>
        <text x="315" y="510" text-anchor="middle">Sur Andino</text>
      </g>

      <!-- Trazados de Rutas Geográficas -->

      <!-- 1. Ruta Próximamente (Selva Central) - Trazo Azul/Verde Punteado -->
      <path
        class="route-path-coming"
        d="M 230 310
           Q 270 290, 310 280
           T 350 250"
        fill="none"
        stroke="rgba(89, 197, 180, 0.55)"
        stroke-width="2"
        stroke-dasharray="4,5"
      />

      <!-- 2. Ruta en Planificación (Sur Andino) - Trazo Gris Oscuro Punteado -->
      <path
        class="route-path-planned"
        d="M 245 460
           C 270 475, 295 470, 315 495
           S 330 520, 350 535"
        fill="none"
        stroke="rgba(245, 245, 240, 0.25)"
        stroke-width="1.8"
        stroke-dasharray="4,6"
      />

      <!-- 3. RUTA PILOTO (Disponible) - Trazo de Acento Dorado Brillante -->
      <path
        class="route-path-active"
        d="M 205 285
           C 215 315, 230 330, 240 360
           C 245 375, 255 390, 275 425
           L 290 455"
        fill="none"
        stroke="var(--color-accent-strong)"
        stroke-width="3"
        stroke-linecap="round"
        filter="url(#glow-gold)"
      />

      <!-- Indicador Visual/Pin del Tramo Piloto Activo -->
      <g class="map-pin" transform="translate(240, 360)">
        <circle cx="0" cy="0" r="8" fill="rgba(197, 160, 89, 0.2)" />
        <circle cx="0" cy="0" r="4.5" fill="var(--color-accent-strong)" />
      </g>

      <!-- Tooltip / Cuadro Indicador Aprobado en Maqueta -->
      <g class="map-tooltip" transform="translate(245, 315)" filter="url(#shadow-dark)">
        <!-- Fondo del Tooltip -->
        <rect x="0" y="0" width="125" height="42" rx="4" fill="var(--color-accent-strong)" />
        <!-- Texto del Tooltip -->
        <text x="12" y="17" font-family="var(--font-interface)" font-size="10.5" font-weight="700" fill="#1c150c">Ruta andina</text>
        <text x="12" y="30" font-family="var(--font-interface)" font-size="9" font-weight="500" fill="rgba(28, 21, 12, 0.75)">Tramo piloto</text>
      </g>
    </svg>



  </div>
</div>

<style>
  .map-preview-container {
    position: relative;
    width: 100%;
    max-width: 480px;
    background-color: rgba(13, 20, 38, 0.3);
    border: 1px solid rgba(245, 245, 240, 0.04);
    border-radius: 8px;
    padding: 20px;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.5), 0 10px 40px rgba(0, 0, 0, 0.3);
    overflow: hidden;
  }

  .map-aspect-ratio {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 124%; /* Relación de aspecto 500:620 */
  }

  .map-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .peru-contour {
    transition: stroke var(--transition-smooth);
  }

  .peru-contour:hover {
    stroke: rgba(245, 245, 240, 0.25);
  }

  .route-path-active {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: drawRoute 3s ease-out forwards;
  }

  /* Animación sutil de entrada para la ruta activa */
  @keyframes drawRoute {
    to {
      stroke-dashoffset: 0;
    }
  }



  @media (max-width: 768px) {
    .map-preview-container {
      max-width: 100%;
      padding: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-path-active {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
