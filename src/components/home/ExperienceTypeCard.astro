---
import { publicUrl } from '../../lib/urls/public-url';

interface Props {
  title: string;
  description: string;
  image: string;
  exploreHref: string;
}

const { title, description, image, exploreHref } = Astro.props;
const resolvedImage = publicUrl(image);
---

<a href={exploreHref} class="experience-card glass-panel" aria-label={`Explorar experiencia de ${title}: ${description}`}>
  <!-- Imagen de Fondo -->
  <div class="card-bg-wrapper">
    <img
      src={resolvedImage}
      alt=""
      class="card-bg"
      loading="lazy"
      width="380"
      height="480"
    />
    <div class="card-overlay"></div>
  </div>

  <!-- Contenido de la Tarjeta -->
  <div class="card-content">
    <div class="card-icon-container" aria-hidden="true">
      <slot name="icon" />
    </div>

    <div class="card-text-container">
      <h3 class="card-title">{title}</h3>
      <p class="card-description">{description}</p>
    </div>
  </div>
</a>

<style>
  .experience-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 400px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(245, 245, 240, 0.06);
    text-decoration: none;
    transition: transform var(--transition-smooth), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
    background-color: var(--color-bg-secondary);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .card-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .card-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 15, 30, 0.1) 0%,
      rgba(10, 15, 30, 0.5) 50%,
      rgba(10, 15, 30, 0.95) 100%
    );
    transition: background var(--transition-smooth);
  }

  .card-content {
    position: relative;
    z-index: 2;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-icon-container {
    color: var(--color-accent-strong);
    width: 32px;
    height: 32px;
    opacity: 0.85;
    transition: transform var(--transition-smooth), opacity var(--transition-smooth);
  }

  :global(.card-icon-container svg) {
    width: 100%;
    height: 100%;
  }

  .card-text-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-title {
    font-family: var(--font-editorial);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.2;
  }

  .card-description {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    opacity: 0.85;
  }

  /* Estados de Interacción */
  .experience-card:hover {
    transform: translateY(-8px);
    border-color: rgba(197, 160, 89, 0.35);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 15px rgba(197, 160, 89, 0.1);
  }

  .experience-card:hover .card-bg {
    transform: scale(1.06);
  }

  .experience-card:hover .card-overlay {
    background: linear-gradient(
      to bottom,
      rgba(10, 15, 30, 0) 0%,
      rgba(10, 15, 30, 0.4) 40%,
      rgba(10, 15, 30, 0.9) 100%
    );
  }

  .experience-card:hover .card-icon-container {
    transform: translateY(-4px);
    opacity: 1;
  }

  .experience-card:focus-visible {
    outline: 2px solid var(--color-accent-strong);
    outline-offset: 4px;
  }

  @media (max-width: 768px) {
    .experience-card {
      height: 320px;
    }

    .card-content {
      padding: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-card:hover,
    .experience-card:hover .card-bg,
    .experience-card:hover .card-icon-container {
      transform: none;
      transition: none;
    }
  }
</style>
