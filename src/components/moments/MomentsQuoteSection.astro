---
import { momentsPageData } from '../../data/moments-page';
import { publicUrl } from '../../lib/urls/public-url';

const { quote, description, author, image, imageAlt, stats } = momentsPageData.quoteSection;
---

<section class="quote-section container" aria-label="Reflexión editorial de Aldo Jara">
  <div class="quote-card glass-panel">
    <!-- Columna Izquierda: Imagen del Viajero -->
    <div class="quote-media">
      <img
        src={publicUrl(image)}
        alt={imageAlt}
        class="quote-image"
        loading="lazy"
      />
      <div class="media-overlay"></div>
    </div>

    <!-- Columna Derecha: Cita y Estadísticas -->
    <div class="quote-content">
      <blockquote class="editorial-blockquote">
        <svg class="quote-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.988zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>
        <p class="quote-text">{quote}</p>
        <cite class="quote-author">— {author}</cite>
      </blockquote>

      <p class="quote-description">{description}</p>

      <!-- Estadísticas honestas -->
      <div class="quote-stats-grid">
        {stats.map(stat => (
          <div class="stat-item">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-desc">{stat.description}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .quote-section {
    padding: 6rem 0;
  }

  .quote-card {
    display: grid;
    grid-template-columns: 45% 55%;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .quote-media {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: var(--color-bg-primary);
  }

  .quote-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, transparent 50%, var(--color-bg-secondary) 100%);
  }

  .quote-content {
    padding: 3.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .editorial-blockquote {
    position: relative;
    margin: 0 0 1.5rem 0;
    padding-left: 0;
  }

  .quote-icon {
    width: 32px;
    height: 32px;
    color: var(--color-accent-dim);
    margin-bottom: 1rem;
  }

  .quote-text {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1.4;
    color: var(--color-text-primary);
    margin: 0 0 0.75rem 0;
    font-style: italic;
  }

  .quote-author {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-accent-strong);
    font-style: normal;
    font-weight: 500;
  }

  .quote-description {
    font-family: var(--font-interface);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 3rem 0;
    max-width: 500px;
  }

  /* Estadísticas */
  .quote-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--color-accent-strong);
    line-height: 1.1;
  }

  .stat-label {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: 4px;
  }

  .stat-desc {
    font-family: var(--font-interface);
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }

  /* Responsivo */
  @media (max-width: 1024px) {
    .quote-card {
      grid-template-columns: 1fr;
    }

    .quote-media {
      height: 300px;
      min-height: auto;
    }

    .media-overlay {
      background: linear-gradient(to bottom, transparent 50%, var(--color-bg-secondary) 100%);
    }

    .quote-content {
      padding: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .quote-section {
      padding: 4rem 0;
    }

    .quote-stats-grid {
      grid-template-columns: 1fr;
      row-gap: 1.25rem;
      padding-top: 1.5rem;
    }
  }
</style>
