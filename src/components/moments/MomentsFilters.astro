---
import { momentsPageData } from '../../data/moments-page';

const filters = momentsPageData.filters;
---

<div class="filters-bar-container container animate-fade-in" id="galeria-momentos">
  <div class="filters-scroll-wrapper">
    <div class="filters-list" role="tablist" aria-label="Filtros de momentos">
      {filters.map(filter => (
        <button
          role="tab"
          aria-selected={filter.active ? "true" : "false"}
          class={`filter-btn ${filter.active ? 'filter-btn--active' : 'filter-btn--disabled'}`}
          aria-disabled={filter.active ? undefined : "true"}
          tabindex={filter.active ? 0 : -1}
        >
          {filter.label}
        </button>
      ))}
    </div>
  </div>
  <p class="filters-legend" id="filters-note">
    <svg class="legend-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="16" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12.01" y2="8"></line>
    </svg>
    <span>Filtros disponibles en una siguiente fase de desarrollo</span>
  </p>
</div>

<style>
  .filters-bar-container {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    scroll-margin-top: calc(var(--header-height) + 20px);
  }

  .filters-scroll-wrapper {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
    padding-bottom: 0.5rem;
  }

  .filters-scroll-wrapper::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }

  .filters-list {
    display: flex;
    gap: 0.75rem;
    min-width: max-content;
  }

  .filter-btn {
    font-family: var(--font-interface);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.55rem 1.25rem;
    border-radius: 30px;
    cursor: pointer;
    transition: var(--transition-fast);
    border: 1px solid transparent;
  }

  .filter-btn--active {
    background-color: var(--color-accent);
    color: var(--color-bg-primary);
    border-color: var(--color-accent);
    font-weight: 600;
  }

  .filter-btn--active:hover {
    background-color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  .filter-btn--disabled {
    background-color: rgba(16, 27, 36, 0.4);
    color: var(--color-text-secondary);
    border-color: var(--color-border);
    cursor: not-allowed;
    opacity: 0.75;
  }

  .filter-btn--disabled:hover {
    border-color: rgba(184, 190, 196, 0.2);
    color: var(--color-text-primary);
  }

  .filters-legend {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .legend-icon {
    width: 14px;
    height: 14px;
    color: var(--color-route-upcoming);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .filters-bar-container {
      margin-bottom: 2rem;
    }

    .filter-btn {
      font-size: 0.85rem;
      padding: 0.5rem 1.1rem;
    }
  }
</style>
