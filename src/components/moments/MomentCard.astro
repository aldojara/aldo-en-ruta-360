---
import type { MomentEntry } from '../../types/moment';
import { publicUrl } from '../../lib/urls/public-url';

interface Props {
  moment: MomentEntry;
  index: number;
}

const { moment, index } = Astro.props;
const {
  title,
  description,
  mediaType,
  image,
  imageAlt,
  territory,
  locationLabel,
  kilometer,
  altitude,
  availability
} = moment.data;

const resolvedImage = publicUrl(image);

// Mapeo de tipos a texto e icono
const getMediaTypeDetails = (type: string) => {
  switch (type) {
    case 'panorama360':
      return { label: '360°', class: 'type-360' };
    case 'video':
      return { label: 'Vídeo', class: 'type-video' };
    case 'photo':
    default:
      return { label: 'Fotografía', class: 'type-photo' };
  }
};

const mediaDetails = getMediaTypeDetails(mediaType);
---

<article class={`moment-card ${availability === 'projected' ? 'moment-card--projected' : ''}`} data-index={index}>
  <div class="card-media-wrapper">
    <img
      src={resolvedImage}
      alt={imageAlt}
      class="card-image"
      loading="lazy"
    />
    <div class="card-overlay" aria-hidden="true"></div>

    <!-- Indicador de Tipo en la esquina superior izquierda -->
    <div class={`media-type-badge ${mediaDetails.class}`}>
      {mediaType === 'panorama360' && (
        <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v12"></path>
          <path d="M6 12h12"></path>
        </svg>
      )}
      {mediaType === 'video' && (
        <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="10 8 16 11 10 14 10 8"></polygon>
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        </svg>
      )}
      {mediaType === 'photo' && (
        <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
          <circle cx="12" cy="13" r="4"></circle>
        </svg>
      )}
      <span class="badge-label">{mediaDetails.label}</span>
    </div>

    <!-- Estado de disponibilidad en la esquina superior derecha -->
    {availability === 'projected' && (
      <span class="availability-status availability-status--projected" aria-label="Contenido proyectado">
        Proyectado
      </span>
    )}
  </div>

  <div class="card-info">
    <div class="card-meta-top">
      <span class="card-territory">{territory || 'Andes'}</span>
      <span class="card-separator" aria-hidden="true">•</span>
      <span class="card-location-label">{locationLabel || 'Ubicación referencial'}</span>
    </div>

    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>

    <div class="card-meta-footer">
      <div class="meta-item">
        <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Ruta andina — Tramo piloto</span>
      </div>

      <div class="meta-item-group">
        {kilometer !== null && kilometer !== undefined && (
          <div class="meta-item">
            <span>Km {kilometer}</span>
          </div>
        )}
        {altitude !== null && altitude !== undefined && (
          <div class="meta-item">
            <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
            <span>{altitude.toLocaleString()} m</span>
          </div>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .moment-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: var(--transition-smooth);
    position: relative;
  }

  .moment-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hover);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .card-media-wrapper {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
    background-color: var(--color-bg-primary);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .moment-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(5, 12, 18, 0.4) 0%, transparent 100%);
  }

  /* Badges en Media */
  .media-type-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 20px;
    background-color: rgba(5, 12, 18, 0.8);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 2;
  }

  .badge-icon {
    width: 13px;
    height: 13px;
  }

  .badge-label {
    font-family: var(--font-interface);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
  }

  .type-360 .badge-icon {
    color: var(--color-route-upcoming);
  }

  .type-video .badge-icon {
    color: var(--color-route-upcoming);
  }

  .type-photo .badge-icon {
    color: var(--color-accent-strong);
  }

  .availability-status {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--font-interface);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: 4px;
    z-index: 2;
  }

  .availability-status--projected {
    background-color: rgba(61, 156, 154, 0.15);
    color: var(--color-route-upcoming);
    border: 1px solid rgba(61, 156, 154, 0.3);
  }

  /* Informacion de la Tarjeta */
  .card-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-interface);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .card-territory {
    color: var(--color-accent);
  }

  .card-separator {
    color: rgba(255, 255, 255, 0.1);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    font-weight: 400;
  }

  .card-description {
    font-family: var(--font-interface);
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  /* Footer de la tarjeta */
  .card-meta-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    margin-top: auto;
    font-family: var(--font-interface);
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta-icon {
    width: 14px;
    height: 14px;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .meta-item-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  @media (max-width: 480px) {
    .card-info {
      padding: 1.25rem;
    }

    .card-title {
      font-size: 1.25rem;
    }
  }
</style>
