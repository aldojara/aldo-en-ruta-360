---
import { navigationItems } from '../../data/navigation';
import { publicUrl } from '../../lib/urls/public-url';

const { pathname } = Astro.url;

// Normalizar pathname para comparaciones
const cleanPathname = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;

const isActive = (href: string) => {
  if (href === '/') {
    return cleanPathname === '/';
  }
  // Coincidencia exacta o subrutas
  return cleanPathname === href || cleanPathname.startsWith(href + '/');
};
---

<header class="main-header glass-panel">
  <div class="header-container container-wide">
    <!-- Logotipo principal enlazando a Inicio -->
    <a href={publicUrl('/')} class="logo-link" aria-label="Volver a Inicio">
      <span class="logo-text">Aldo en Ruta</span>
      <span class="logo-subtext">360°</span>
    </a>

    <!-- Navegación de Escritorio -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {navigationItems.map(item => {
          const active = isActive(item.href);
          return (
            <li>
              <a 
                href={publicUrl(item.href)} 
                class={`nav-link ${active ? 'active' : ''}`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Botón de Control Accesible para Menú Móvil -->
    <button 
      class="mobile-toggle" 
      aria-label="Abrir menú de navegación" 
      aria-expanded="false" 
      aria-controls="mobile-menu"
      id="menu-toggle-btn"
    >
      <svg class="hamburger" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12" class="line-mid"></line>
        <line x1="3" y1="6" x2="21" y2="6" class="line-top"></line>
        <line x1="3" y1="18" x2="21" y2="18" class="line-bot"></line>
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Móvil -->
  <nav class="mobile-nav" id="mobile-menu" aria-label="Navegación móvil" aria-hidden="true">
    <ul class="mobile-nav-list">
      {navigationItems.map(item => {
        const active = isActive(item.href);
        return (
          <li>
            <a 
              href={publicUrl(item.href)} 
              class={`mobile-nav-link ${active ? 'active' : ''}`}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    const focusableElements = mobileMenu.querySelectorAll('a, button');
    const firstFocusable = toggleBtn;
    const lastFocusable = focusableElements[focusableElements.length - 1] as HTMLElement;

    const openMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'true');
      mobileMenu.setAttribute('aria-hidden', 'false');
      toggleBtn.classList.add('is-active');
      mobileMenu.classList.add('is-open');
      toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      toggleBtn.classList.remove('is-active');
      mobileMenu.classList.remove('is-open');
      toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
      document.body.style.overflow = '';
      toggleBtn.focus();
    };

    const toggleMenu = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    };

    toggleBtn.addEventListener('click', toggleMenu);

    // Cierre con Escape y gestión de foco accesible
    document.addEventListener('keydown', (e) => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (!isExpanded) return;

      if (e.key === 'Escape') {
        closeMenu();
      }

      if (e.key === 'Tab') {
        // Trap Focus
        if (e.shiftKey) {
          // shift + tab
          if (document.activeElement === firstFocusable) {
            lastFocusable.focus();
            e.preventDefault();
          }
        } else {
          // tab
          if (document.activeElement === lastFocusable) {
            firstFocusable.focus();
            e.preventDefault();
          }
        }
      }
    });
  }
</script>

<style>
  .main-header {
    position: fixed;
    top: 20px;
    left: 20px;
    right: 20px;
    height: var(--header-height);
    z-index: var(--z-header);
    border-radius: var(--radius-md);
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* Logo */
  .logo-link {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    font-weight: 500;
  }

  .logo-subtext {
    font-size: 0.75rem;
    color: var(--color-accent);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: block;
  }

  .nav-list {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-link {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    font-family: var(--font-interface);
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 8px 0;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-link.active {
    color: var(--color-accent-strong);
  }

  .nav-link.active::after {
    transform: scaleX(1);
    background-color: var(--color-accent-strong);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    color: var(--color-text-primary);
    padding: 8px;
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }

  .mobile-toggle:hover {
    background-color: var(--color-surface);
  }

  .hamburger line {
    transition: var(--transition-smooth);
    transform-origin: center;
  }

  /* Menu Toggle Animations */
  .mobile-toggle.is-active .line-mid {
    opacity: 0;
    transform: scale(0);
  }

  .mobile-toggle.is-active .line-top {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-toggle.is-active .line-bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Dropdown Nav */
  .mobile-nav {
    display: none;
    position: fixed;
    top: calc(20px + var(--header-height) + 12px);
    left: 20px;
    right: 20px;
    background-color: var(--color-surface-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 24px;
    z-index: calc(var(--z-header) - 1);
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: var(--transition-smooth);
  }

  .mobile-nav.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mobile-nav-link {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    display: block;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    color: var(--color-accent-strong);
    padding-left: 8px;
  }

  /* Media Queries */
  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
