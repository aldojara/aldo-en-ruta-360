---
import { navigationItems } from '../../data/navigation';
import { publicUrl } from '../../lib/urls/public-url';
import { stripBasePath } from '../../lib/urls/strip-base-path';

const currentPath = stripBasePath(Astro.url.pathname);

const normalizeHref = (href: string) =>
  href === '/' ? '/' : href.replace(/\/+$/, '');

const isActive = (href: string) => {
  const normalizedHref = normalizeHref(href);

  if (normalizedHref === '/') {
    return currentPath === '/';
  }

  return (
    currentPath === normalizedHref ||
    currentPath.startsWith(`${normalizedHref}/`)
  );
};
---

<header class="main-header">
  <div class="header-container container-wide">
    <!-- Logotipo principal enlazando a Inicio -->
    <a href={publicUrl('/')} class="logo-link" aria-label="Volver a Inicio">
      <svg class="logo-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 20 L10 6 L17 20 Z" />
        <path d="M14 20 L18 12 L22 20 Z" />
      </svg>
      <div class="logo-text-wrapper">
        <span class="logo-text">Aldo en Ruta</span>
        <span class="logo-subtext">Viajes, carreteras y experiencias inmersivas</span>
      </div>
    </a>

    <!-- Navegación de Escritorio -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {navigationItems.map(item => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={publicUrl(item.href)}
                class={`nav-link ${active ? 'active' : ''}`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-right">
      <!-- Botón de Control Accesible para Menú Móvil -->
      <button
        class="mobile-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="menu-toggle-btn"
      >
        <svg class="hamburger" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12" class="line-mid"></line>
          <line x1="3" y1="6" x2="21" y2="6" class="line-top"></line>
          <line x1="3" y1="18" x2="21" y2="18" class="line-bot"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú Desplegable Móvil -->
  <nav class="mobile-nav" id="mobile-menu" aria-label="Navegación móvil" aria-hidden="true">
    <ul class="mobile-nav-list">
      {navigationItems.map(item => {
        const active = isActive(item.href);
        return (
          <li>
            <a
              href={publicUrl(item.href)}
              class={`mobile-nav-link ${active ? 'active' : ''}`}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    const focusableElements = mobileMenu.querySelectorAll('a, button');
    const firstFocusable = toggleBtn;
    const lastFocusable = focusableElements[focusableElements.length - 1] as HTMLElement;

    const openMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'true');
      mobileMenu.setAttribute('aria-hidden', 'false');
      toggleBtn.classList.add('is-active');
      mobileMenu.classList.add('is-open');
      toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      toggleBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      toggleBtn.classList.remove('is-active');
      mobileMenu.classList.remove('is-open');
      toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
      document.body.style.overflow = '';
      toggleBtn.focus();
    };

    const toggleMenu = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    };

    toggleBtn.addEventListener('click', toggleMenu);

    // Cierre con Escape y gestión de foco accesible
    document.addEventListener('keydown', (e) => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (!isExpanded) return;

      if (e.key === 'Escape') {
        closeMenu();
      }

      if (e.key === 'Tab') {
        // Trap Focus
        if (e.shiftKey) {
          // shift + tab
          if (document.activeElement === firstFocusable) {
            lastFocusable.focus();
            e.preventDefault();
          }
        } else {
          // tab
          if (document.activeElement === lastFocusable) {
            firstFocusable.focus();
            e.preventDefault();
          }
        }
      }
    });
  }
</script>

<style>
  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-header);
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    background: linear-gradient(to bottom, rgba(10, 15, 30, 0.8) 0%, rgba(10, 15, 30, 0.2) 60%, transparent 100%);
    padding: 0 40px;
    border-bottom: 1px solid rgba(245, 245, 240, 0.04);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* Logo */
  .logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-symbol {
    width: 26px;
    height: 26px;
    color: var(--color-accent-strong);
    flex-shrink: 0;
  }

  .logo-text-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
    font-weight: 500;
    line-height: 1.1;
  }

  .logo-subtext {
    font-family: var(--font-interface);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.1;
    text-transform: none;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: block;
  }

  .nav-list {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-link {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    font-family: var(--font-interface);
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 8px 0;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-link.active {
    color: var(--color-accent-strong);
  }

  .nav-link.active::after {
    transform: scaleX(1);
    background-color: var(--color-accent-strong);
  }

  /* Header Right Controls */
  .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }



  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    color: var(--color-text);
    padding: 8px;
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .mobile-toggle:hover {
    background-color: rgba(245, 245, 240, 0.05);
  }

  .hamburger line {
    transition: var(--transition-smooth);
    transform-origin: center;
  }

  /* Menu Toggle Animations */
  .mobile-toggle.is-active .line-mid {
    opacity: 0;
    transform: scale(0);
  }

  .mobile-toggle.is-active .line-top {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-toggle.is-active .line-bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Dropdown Nav */
  .mobile-nav {
    display: none;
    position: fixed;
    top: calc(20px + var(--header-height) + 12px);
    left: 20px;
    right: 20px;
    background-color: var(--color-surface-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 24px;
    z-index: calc(var(--z-header) - 1);
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: var(--transition-smooth);
  }

  .mobile-nav.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mobile-nav-link {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    display: block;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    color: var(--color-accent-strong);
    padding-left: 8px;
  }

  /* Media Queries */
  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
