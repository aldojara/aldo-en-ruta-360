---
import { publicUrl } from '../../lib/urls/public-url';
import type { AboutPageData } from '../../data/about';

interface Props {
  story: AboutPageData['story'];
}

const { story } = Astro.props;

const resolvedImage = publicUrl(story.image);
---

<section class="about-story-section">
  <div class="story-container container">
    <div class="story-grid">
      <!-- Columna izquierda: Imagen editorial -->
      <div class="story-visual-col animate-fade-in">
        <div class="story-image-wrapper">
          <img src={resolvedImage} alt={story.imageAlt} class="story-image" loading="lazy" />
          <div class="story-image-overlay"></div>
        </div>
      </div>

      <!-- Columna derecha: Texto narrativo -->
      <div class="story-text-col animate-fade-in">
        <span class="story-eyebrow">{story.eyebrow}</span>
        <h2 class="story-title">{story.title}</h2>
        
        <div class="story-paragraphs">
          {story.paragraphs.map(p => (
            <p class="story-p">{p}</p>
          ))}
        </div>

        <!-- Enlace al perfil profesional -->
        <div class="story-action-wrapper">
          <a 
            href="https://aldojarapisconti.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-professional" 
          >
            <span>{story.profileButton.label}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-story-section {
    padding: 100px 0;
    background-color: var(--color-bg-primary);
    position: relative;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: center;
  }

  /* Columna Visual */
  .story-visual-col {
    position: relative;
  }

  .story-image-wrapper {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    aspect-ratio: 4/3;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  }

  .story-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 70%;
    transition: transform 0.5s ease;
  }

  .story-image-wrapper:hover .story-image {
    transform: scale(1.02);
  }

  .story-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 12, 18, 0.3) 0%, transparent 50%);
    pointer-events: none;
  }

  /* Columna Texto */
  .story-text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .story-eyebrow {
    font-family: var(--font-interface);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent-strong);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 16px;
  }

  .story-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    color: var(--color-text-primary);
    line-height: 1.25;
    margin: 0 0 28px 0;
  }

  .story-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 36px;
  }

  .story-p {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  /* Botón e Indicación Prototipo */
  .story-action-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-professional {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    border: 1px solid rgba(245, 245, 240, 0.25);
    color: var(--color-text-primary);
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-family: var(--font-interface);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .btn-professional:hover {
    background-color: var(--color-accent-dim);
    border-color: var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  .btn-professional svg {
    transition: transform var(--transition-smooth);
  }

  .btn-professional:hover svg {
    transform: translateX(4px);
  }

  .badge-provisional {
    font-family: var(--font-interface);
    font-size: 0.72rem;
    color: var(--color-accent-strong);
    background-color: rgba(216, 154, 43, 0.1);
    border: 1px solid rgba(216, 154, 43, 0.25);
    padding: 4px 10px;
    border-radius: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  /* Responsivo */
  @media (max-width: 900px) {
    .about-story-section {
      padding: 60px 0;
    }

    .story-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .story-image-wrapper {
      aspect-ratio: 16/10;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
