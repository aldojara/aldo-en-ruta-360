---
import type { AboutMetric } from '../../data/about';

interface Props {
  metrics: AboutMetric[];
}

const { metrics } = Astro.props;
---

<section class="about-stats-section">
  <div class="stats-container container">
    <div class="stats-glass-wrapper glass-panel">
      {metrics.map((metric, index) => (
        <div class="stat-card">
          <!-- Separador vertical en Desktop (se pinta con CSS border) -->
          <div class="stat-icon-wrapper">
            {index === 0 && (
              /* Tecnología: Monitor/Terminal */
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            )}
            {index === 1 && (
              /* Carretera/KM: Mapa/Ruta */
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 6v14l6-3 6 3 6-3 6 3V6l-6 3-6-3-6 3-6-3z"></path>
                <line x1="7" y1="6" x2="7" y2="17"></line>
                <line x1="13" y1="7" x2="13" y2="20"></line>
              </svg>
            )}
            {index === 2 && (
              /* 360°: Cámara de 360 */
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
            )}
            {index === 3 && (
              /* Territorios: Regiones/Montaña */
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 22h20L12 2z"></path>
              </svg>
            )}
            {index === 4 && (
              /* Momentos: Reproductor de vídeo */
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            )}
          </div>
          
          <div class="stat-content">
            <span class="stat-value text-gradient">{metric.value}</span>
            <span class="stat-label">{metric.label}</span>
            <span class="stat-desc">{metric.description}</span>
            <span class="stat-badge">{metric.statusLabel}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-stats-section {
    padding: 0;
    margin-top: -30px; /* Superponer ligeramente sobre el degradado del hero */
    position: relative;
    z-index: 10;
  }

  .stats-container {
    width: 100%;
  }

  .stats-glass-wrapper {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 24px;
    background-color: rgba(16, 27, 36, 0.65);
    border-radius: var(--radius-lg);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 16px 20px;
    gap: 16px;
    position: relative;
    transition: var(--transition-smooth);
  }

  /* Bordes separadores verticales */
  .stat-card:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 15%;
    height: 70%;
    width: 1px;
    background-color: var(--color-border);
  }

  .stat-card:hover {
    transform: translateY(-2px);
  }

  .stat-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: rgba(216, 154, 43, 0.08);
    color: var(--color-accent);
    border: 1px solid rgba(216, 154, 43, 0.15);
    transition: var(--transition-smooth);
  }

  .stat-card:hover .stat-icon-wrapper {
    color: var(--color-accent-strong);
    background-color: rgba(216, 154, 43, 0.15);
    border-color: rgba(216, 154, 43, 0.4);
    box-shadow: 0 0 12px rgba(216, 154, 43, 0.2);
  }

  .stat-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .stat-label {
    font-family: var(--font-interface);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .stat-desc {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .stat-badge {
    font-family: var(--font-interface);
    font-size: 0.68rem;
    color: var(--color-accent-strong);
    background-color: rgba(216, 154, 43, 0.1);
    border: 1px solid rgba(216, 154, 43, 0.2);
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 500;
    margin-top: 8px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Responsivo */
  @media (max-width: 1024px) {
    .stats-glass-wrapper {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .stat-card::after {
      display: none; /* Quitar separadores */
    }

    /* Dibujar bordes divisorios alternativos en tablet si se desea, o simplemente quitar */
  }

  @media (max-width: 640px) {
    .stats-glass-wrapper {
      grid-template-columns: repeat(2, 1fr);
      padding: 16px;
    }
  }

  @media (max-width: 400px) {
    .stats-glass-wrapper {
      grid-template-columns: 1fr;
    }
  }
</style>
