---
import type { StoryEntry } from '../../types/story';
import { publicUrl } from '../../lib/urls/public-url';

interface Props {
  story: StoryEntry;
}

const { story } = Astro.props;
const {
  title,
  excerpt,
  category,
  contextLabel,
  readingTimeMinutes,
  image,
  imageAlt,
  status
} = story.data;

const resolvedImage = publicUrl(image);

const getCategoryLabel = (cat: string) => {
  switch (cat) {
    case 'chronicle': return 'Crónica';
    case 'logbook': return 'Bitácora';
    case 'behind-the-route': return 'Detrás de la ruta';
    case 'preparation': return 'Preparación';
    case 'learning': return 'Aprendizaje';
    case 'encounter': return 'Encuentro';
    default: return cat;
  }
};

const categoryLabel = getCategoryLabel(category);
---

<article class="story-list-item">
  <div class="item-media">
    <img
      src={resolvedImage}
      alt={imageAlt}
      class="item-image"
      loading="lazy"
    />
    <div class="media-overlay" aria-hidden="true"></div>
    <span class="category-tag">{categoryLabel}</span>
  </div>

  <div class="item-content">
    <div class="meta-row">
      <span class="meta-context">{contextLabel}</span>
      <span class="meta-separator" aria-hidden="true">•</span>
      <span class="meta-time">{readingTimeMinutes} min de lectura</span>
    </div>

    <h3 class="item-title">{title}</h3>
    <p class="item-excerpt">{excerpt}</p>

    <div class="item-footer">
      {status === 'provisional' && (
        <span class="status-badge">En preparación</span>
      )}
      <span class="availability-text">Próximamente disponible</span>
    </div>
  </div>
</article>

<style>
  .story-list-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: var(--transition-smooth);
    min-height: 180px;
  }

  .story-list-item:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .item-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-bg-primary);
  }

  .item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .story-list-item:hover .item-image {
    transform: scale(1.04);
  }

  .media-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(8, 20, 28, 0.3) 0%, transparent 100%);
  }

  .category-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-family: var(--font-interface);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(5, 12, 18, 0.85);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: var(--color-text-primary);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .item-content {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-interface);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .meta-context {
    color: var(--color-accent);
  }

  .meta-separator {
    color: rgba(255, 255, 255, 0.1);
  }

  .item-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .item-excerpt {
    font-family: var(--font-interface);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .item-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    font-family: var(--font-interface);
  }

  .status-badge {
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1px 6px;
    border-radius: 4px;
    background-color: rgba(61, 156, 154, 0.1);
    color: var(--color-route-upcoming);
    border: 1px solid rgba(61, 156, 154, 0.2);
  }

  .availability-text {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* Responsivo */
  @media (max-width: 768px) {
    .story-list-item {
      grid-template-columns: 1fr;
    }

    .item-media {
      height: 160px;
    }

    .category-tag {
      bottom: auto;
      top: 12px;
    }

    .media-overlay {
      background: linear-gradient(to top, rgba(8, 20, 28, 0.5) 0%, transparent 100%);
    }

    .item-content {
      padding: 1.25rem;
    }
  }
</style>
