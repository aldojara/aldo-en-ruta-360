---
import { storiesPageData } from '../../data/stories-page';
import { publicUrl } from '../../lib/urls/public-url';

const milestones = storiesPageData.timeline;
---

<section class="story-timeline-section" aria-label="Cronología narrativa del tramo piloto">
  <div class="container">
    <div class="timeline-header">
      <span class="timeline-eyebrow">ESTRUCTURA DE VIAJE</span>
      <h2 class="timeline-title">Historias del tramo piloto</h2>
      <p class="timeline-subtitle">El recorrido como una secuencia narrativa: desde la concepción hasta la bitácora final.</p>
    </div>

    <div class="timeline-container">
      <div class="timeline-connecting-line" aria-hidden="true"></div>

      <div class="timeline-milestones-grid">
        {milestones.map(milestone => (
          <div class="timeline-milestone" data-step={milestone.step}>
            <div class="milestone-media">
              <span class="milestone-number" aria-label={`Etapa número ${milestone.step}`}>{milestone.step}</span>
              <img
                src={publicUrl(milestone.image)}
                alt={`Ilustración de la etapa: ${milestone.title}`}
                class="milestone-thumbnail"
                loading="lazy"
              />
            </div>
            <div class="milestone-info">
              <h3 class="milestone-title">{milestone.title}</h3>
              <p class="milestone-desc">{milestone.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .story-timeline-section {
    padding: 6rem 0;
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .timeline-header {
    margin-bottom: 4rem;
  }

  .timeline-eyebrow {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    font-weight: 400;
  }

  .timeline-subtitle {
    font-family: var(--font-interface);
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 600px;
  }

  .timeline-container {
    position: relative;
    width: 100%;
    padding: 2rem 0;
  }

  .timeline-connecting-line {
    position: absolute;
    top: calc(2rem + 40px); /* Alineado al centro de la miniatura de 80px */
    left: 40px;
    right: 40px;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-border) 0px,
      var(--color-border) 6px,
      transparent 6px,
      transparent 12px
    );
    z-index: 1;
  }

  .timeline-milestones-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2rem;
  }

  .timeline-milestone {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 2;
  }

  .milestone-media {
    position: relative;
    width: 140px;
    height: 80px;
    border-radius: var(--radius-sm);
    border: 2px solid var(--color-border);
    background-color: var(--color-bg-primary);
    margin-bottom: 1.25rem;
    transition: var(--transition-smooth);
    flex-shrink: 0;
  }

  .timeline-milestone:hover .milestone-media {
    border-color: var(--color-accent);
    transform: scale(1.03);
  }

  .milestone-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-sm) - 2px);
  }

  .milestone-number {
    position: absolute;
    top: -12px;
    left: -12px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-bg-primary);
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-bg-secondary);
    z-index: 3;
  }

  .milestone-info {
    text-align: left;
  }

  .milestone-title {
    font-family: var(--font-interface);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .milestone-desc {
    font-family: var(--font-interface);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Responsivo */
  @media (max-width: 1024px) {
    .timeline-milestones-grid {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 2.5rem;
    }

    .timeline-connecting-line {
      display: none; /* Se elimina la línea horizontal en layouts intermedios */
    }

    .milestone-media {
      width: 120px;
      height: 70px;
    }
  }

  @media (max-width: 768px) {
    .story-timeline-section {
      padding: 4rem 0;
    }

    .timeline-header {
      margin-bottom: 2.5rem;
    }

    .timeline-container {
      padding: 0;
    }

    .timeline-connecting-line {
      display: block;
      top: 0;
      bottom: 0;
      left: 20px;
      width: 1px;
      height: 100%;
      right: auto;
      background: repeating-linear-gradient(
        0deg,
        var(--color-border) 0px,
        var(--color-border) 6px,
        transparent 6px,
        transparent 12px
      );
    }

    .timeline-milestones-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .timeline-milestone {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
      width: 100%;
    }

    .milestone-media {
      margin-bottom: 0;
      width: 90px;
      height: 60px;
    }

    .milestone-number {
      top: -8px;
      left: -8px;
    }
  }
</style>
