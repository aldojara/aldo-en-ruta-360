---
import { exploreExperienceCategories } from '../../data/explore';
import ExperienceCategoryCard from './ExperienceCategoryCard.astro';
---

<section class="experience-grid-section container" aria-labelledby="experience-section-title">
  <h2 id="experience-section-title" class="section-title">Explora por tipo de experiencia</h2>

  <div class="experience-grid">
    {exploreExperienceCategories.map((category) => (
      <ExperienceCategoryCard category={category} />
    ))}
  </div>
</section>

<style>
  .experience-grid-section {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin-bottom: 2rem;
    letter-spacing: -0.01em;
  }

  .experience-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
  }

  /* Responsive breakpoints */
  @media (max-width: 1024px) {
    .experience-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .experience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .experience-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
