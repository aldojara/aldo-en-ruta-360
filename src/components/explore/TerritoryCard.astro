---
import type { ExploreTerritory } from '../../types/explore';
import { publicUrl } from '../../lib/urls/public-url';

interface Props {
  territory: ExploreTerritory;
}

const { territory } = Astro.props;
const resolvedImage = publicUrl(territory.image);
const resolvedHref = publicUrl(territory.href);
---

<a href={resolvedHref} class="territory-card glass-panel" aria-label={`Explorar territorio ${territory.title}: ${territory.description}`}>
  <!-- Imagen de fondo -->
  <div class="card-bg-wrapper">
    <img
      src={resolvedImage}
      alt=""
      class="card-bg-image"
      loading="lazy"
    />
    <div class="card-overlay" aria-hidden="true"></div>
  </div>

  <!-- Contenido de la tarjeta -->
  <div class="card-content">
    <div class="card-header">
      <!-- Iconos vectoriales según la geografía -->
      <div class="icon-wrapper" aria-hidden="true">
        {territory.icon === 'mountain' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M17 21L12 13L7 21" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M21 21L12 7L3 21" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        )}
        {territory.icon === 'coast' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 10c3 0 3 4 6 4s3-4 6-4s3 4 6 4s3-4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M2 15c3 0 3 3 6 3s3-3 6-3s3 3 6 3s3-3 4-3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        )}
        {territory.icon === 'jungle' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 19V5M12 5L8 9M12 5L16 9" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M12 12C9.5 12 7.5 10 7.5 7.5S9.5 3 12 3s4.5 2 4.5 4.5S14.5 12 12 12z" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M12 17C10.5 17 9.5 16 9.5 14.5S10.5 12 12 12s2.5 1.5 2.5 2.5S13.5 17 12 17z" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        )}
        {territory.icon === 'desert' && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 3v18M12 9c3 0 4-1 4-3s-1-3-4-3" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M12 13c-3 0-4 1-4 3s1 3 4 3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        )}
      </div>

      <h3 class="card-title">{territory.title}</h3>
      <p class="card-description">{territory.description}</p>
    </div>

    <div class="card-footer">
      <div class="status-indicator">
        <span class={`status-dot dot-${territory.status}`} aria-hidden="true"></span>
        <span class="status-text">{territory.statusLabel}</span>
      </div>

      <div class="arrow-wrapper" aria-hidden="true">
        <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>
    </div>
  </div>
</a>

<style>
  .territory-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 260px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .territory-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
  }

  .card-bg-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .card-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .territory-card:hover .card-bg-image {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(5, 12, 18, 0.4) 0%,
      rgba(5, 12, 18, 0.85) 100%
    );
  }

  .card-content {
    position: relative;
    z-index: 2;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .icon-wrapper {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background-color: rgba(245, 242, 235, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
    transition: var(--transition-smooth);
  }

  .territory-card:hover .icon-wrapper {
    background-color: var(--color-accent-dim);
    color: var(--color-accent);
  }

  .icon-wrapper svg {
    width: 20px;
    height: 20px;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem 0;
  }

  .card-description {
    font-family: var(--font-interface);
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(184, 190, 196, 0.08);
    padding-top: 0.75rem;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-available {
    background-color: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
  }

  .dot-coming-soon {
    background-color: var(--color-route-upcoming);
  }

  .dot-planning {
    background-color: var(--color-route-planned);
  }

  .status-text {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .arrow-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: var(--transition-smooth);
  }

  .territory-card:hover .arrow-wrapper {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .card-arrow {
    width: 16px;
    height: 16px;
  }
</style>
