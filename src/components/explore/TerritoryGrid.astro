---
import { exploreTerritories } from '../../data/explore';
import TerritoryCard from './TerritoryCard.astro';
---

<section class="territory-grid-section container" aria-labelledby="territory-section-title">
  <h2 id="territory-section-title" class="section-title">Explora por territorio</h2>

  <div class="territory-grid">
    {exploreTerritories.map((territory) => (
      <TerritoryCard territory={territory} />
    ))}
  </div>
</section>

<style>
  .territory-grid-section {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
    color: var(--color-text-primary);
    margin-bottom: 2rem;
    letter-spacing: -0.01em;
  }

  .territory-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  /* Responsive breakpoints */
  @media (max-width: 1024px) {
    .territory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .territory-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
