---
import type { ExploreExperienceCategory } from '../../types/explore';

interface Props {
  category: ExploreExperienceCategory;
}

const { category } = Astro.props;
---

<div class="experience-cat-card glass-panel" aria-label={`Categoría de experiencia: ${category.title}. ${category.description}`}>
  <div class="card-header">
    <div class="icon-wrapper" aria-hidden="true">
      {category.icon === 'winding' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2v20M8 8c4-2 4 4 8 2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M8 16c4-2 4 4 8 2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      )}
      {category.icon === 'panorama' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a10 10 0 1 0 10 10" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M8 12h8M12 8v8" stroke-linecap="round" stroke-linejoin="round"></path>
          <text x="12" y="15" font-size="5" font-family="sans-serif" font-weight="bold" text-anchor="middle" fill="currentColor">360°</text>
        </svg>
      )}
      {category.icon === 'video' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
          <polygon points="10 8 16 12 10 16 10 8"></polygon>
        </svg>
      )}
      {category.icon === 'history' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
      )}
      {category.icon === 'landscape' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 20h18L12 8z" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M16 20h5L17 14z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      )}
    </div>

    <h3 class="card-title">{category.title}</h3>
    <p class="card-description">{category.description}</p>
  </div>

  <div class="card-footer">
    <span class={`status-dot dot-${category.status}`} aria-hidden="true"></span>
    <span class="status-label">{category.statusLabel}</span>
  </div>
</div>

<style>
  .experience-cat-card {
    background-color: rgba(16, 27, 36, 0.4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
    transition: var(--transition-smooth);
  }

  .experience-cat-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .icon-wrapper {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background-color: rgba(245, 242, 235, 0.03);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
    transition: var(--transition-smooth);
  }

  .experience-cat-card:hover .icon-wrapper {
    background-color: var(--color-accent-dim);
    color: var(--color-accent);
  }

  .icon-wrapper svg {
    width: 22px;
    height: 22px;
  }

  .card-title {
    font-family: var(--font-interface);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem 0;
  }

  .card-description {
    font-family: var(--font-interface);
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid rgba(184, 190, 196, 0.08);
    padding-top: 0.75rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-available {
    background-color: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
  }

  .dot-coming-soon {
    background-color: var(--color-route-upcoming);
  }

  .dot-planning {
    background-color: var(--color-route-planned);
  }

  .status-label {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  @media (max-width: 576px) {
    .experience-cat-card {
      min-height: auto;
    }
  }
</style>
