---
import type { RouteEntry } from '../../types/route';
import { publicUrl } from '../../lib/urls/public-url';

interface Props {
  route: RouteEntry;
}

const { route } = Astro.props;
const { metrics, location, title } = route.data;

// Formateador de duración
const formatDuration = (seconds: number) => {
  const mins = Math.round(seconds / 60);
  if (mins < 60) return `${mins} min`;
  const hrs = Math.floor(mins / 60);
  const remainingMins = mins % 60;
  return remainingMins > 0 ? `${hrs} h ${remainingMins} min` : `${hrs} h`;
};

// Traductor de nivel de conducción
const getDifficultyLabel = (difficulty: string) => {
  switch (difficulty) {
    case 'easy': return 'Fácil';
    case 'moderate': return 'Moderada';
    case 'advanced': return 'Avanzada';
    default: return difficulty;
  }
};

const routeUrl = publicUrl('/rutas/');
---

<div class="featured-route-panel glass-panel" aria-label="Ficha de la ruta destacada actual">
  <div class="panel-header">
    <span class="panel-eyebrow">RUTA DESTACADA</span>
    <h3 class="panel-title">{title}</h3>
  </div>

  <div class="panel-metrics">
    <!-- Distancia -->
    <div class="metric-item">
      <div class="metric-icon-wrapper" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <div class="metric-content">
        <span class="metric-label">Distancia</span>
        <span class="metric-value">{metrics.distanceKm} km</span>
      </div>
    </div>

    <!-- Duración -->
    <div class="metric-item">
      <div class="metric-icon-wrapper" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div class="metric-content">
        <span class="metric-label">Duración</span>
        <span class="metric-value">{formatDuration(metrics.durationSeconds)}</span>
      </div>
    </div>

    <!-- Altitud Máxima -->
    {metrics.maximumAltitudeMeters && (
      <div class="metric-item">
        <div class="metric-icon-wrapper" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 10v6M2 10v6M12 4v16M4 18h16"></path>
          </svg>
        </div>
        <div class="metric-content">
          <span class="metric-label">Altitud máxima</span>
          <span class="metric-value">{metrics.maximumAltitudeMeters.toLocaleString('es-PE')} m</span>
        </div>
      </div>
    )}

    <!-- Territorio -->
    <div class="metric-item">
      <div class="metric-icon-wrapper" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a10 10 0 0 0-10 10c0 5.25 10 10 10 10s10-4.75 10-10a10 10 0 0 0-10-10z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </div>
      <div class="metric-content">
        <span class="metric-label">Territorio</span>
        <span class="metric-value">{location.territory}</span>
      </div>
    </div>

    <!-- Conducción -->
    <div class="metric-item">
      <div class="metric-icon-wrapper" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
      </div>
      <div class="metric-content">
        <span class="metric-label">Conducción</span>
        <span class="metric-value">{getDifficultyLabel(metrics.drivingDifficulty)}</span>
      </div>
    </div>
  </div>

  <div class="panel-actions">
    <a href={routeUrl} class="btn-ver-ruta">
      <span>Ver ruta</span>
      <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

  <div class="panel-footer">
    <span class="provisional-tag">Datos provisionales del prototipo</span>
  </div>
</div>

<style>
  .featured-route-panel {
    background-color: rgba(16, 27, 36, 0.72);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  .panel-header {
    margin-bottom: 1.5rem;
  }

  .panel-eyebrow {
    font-family: var(--font-interface);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.4rem;
  }

  .panel-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 400;
    color: var(--color-text-primary);
    margin: 0;
  }

  .panel-metrics {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .metric-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .metric-icon-wrapper {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: rgba(216, 154, 43, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .metric-icon-wrapper svg {
    width: 16px;
    height: 16px;
    color: var(--color-accent);
  }

  .metric-content {
    display: flex;
    flex-direction: column;
  }

  .metric-label {
    font-family: var(--font-interface);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-value {
    font-family: var(--font-interface);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .panel-actions {
    margin-bottom: 1rem;
  }

  .btn-ver-ruta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.75rem 1.25rem;
    background-color: var(--color-accent);
    color: var(--color-bg-primary);
    font-family: var(--font-interface);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: var(--transition-smooth);
    gap: 0.5rem;
  }

  .btn-ver-ruta:hover {
    background-color: var(--color-accent-strong);
    transform: translateY(-1px);
  }

  .btn-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .btn-ver-ruta:hover .btn-arrow {
    transform: translateX(4px);
  }

  .panel-footer {
    text-align: center;
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
  }

  .provisional-tag {
    font-family: var(--font-interface);
    font-size: 0.7rem;
    font-style: italic;
    color: var(--color-text-muted);
  }
</style>
